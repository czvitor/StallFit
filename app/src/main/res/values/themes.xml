<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Actual colors/typography are driven by
         Jetpack Compose (see ui/theme/Theme.kt) — this XML theme only
         controls the window background shown before Compose takes over. -->
    <style name="Theme.StallFit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/background_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/background_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
